{
    "layer": "top",
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "custom/dnd", "tray"],
    "niri/window": {
        "max-length": 50
    },
    "network": {
      "format-wifi": "󰤢 {bandwidthDownBits}",
      "format-ethernet": "󰈀 {bandwidthDownBits}",
      "format-disconnected": "󰤠 No Network",
      "interval": 5,
      "tooltip": false
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{percentage}% "
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format-alt": "{:%Y/%m/%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "",
      "format-icons": {
        "default": ["", "", " "]
      }
  },
  "custom/dnd": {
      "exec": "~/.config/waybar/scripts/dnd.sh",
      "return-type": "json",
      "on-click": "~/.config/waybar/scripts/dnd.sh toggle",
      "on-click-right": "makoctl dismiss --all",
      "signal": 8,
      "interval": 5,
      "tooltip": true
  }
}
